{
  "name": "rateclock",
  "version": "0.1.0",
  "description": "Track work sessions and earnings from the command line",
  "type": "module",
  "bin": {
    "rateclock": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm release:check",
    "release:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm typecheck:tests && pnpm test",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --project tests/tsconfig.json",
    "test": "pnpm build && vitest run"
  },
  "keywords": [
    "cli",
    "freelance",
    "productivity",
    "sqlite",
    "time-tracking"
  ],
  "author": "pablovrl",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablovrl/rateclock.git"
  },
  "homepage": "https://github.com/pablovrl/rateclock#readme",
  "bugs": {
    "url": "https://github.com/pablovrl/rateclock/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
